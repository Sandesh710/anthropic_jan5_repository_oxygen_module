! Namelist configuration file for FLAKE — South Center Lake (2017)

&SIMULATION_PARAMS
del_time_lk   = 86400.0,    ! Time step [s]
time_step_number = 1097,    ! The total number of time steps (17 years 1980-1996)
save_interval_n  = 1        ! Saving interval in time steps 
T_wML_in = 4.			!initial temperature of the upper mixed layer
T_bot_in = 4.			!initial temperature at the bottom
h_ML_in =  3.			!initial mixed layer thickness
/


!------------------------------------------------------------------------------
! Measurement heights/depths [m], names of input and output files
!------------------------------------------------------------------------------
&METEO
z_wind_m(1) =  10.00,
z_Taqa_m(1) =  2.00,
z_Tw_m(1)   =  0.00,
meteofile     = 'south_center_lake_2017-2020.xlsx'
outputfile    = 'South_Center_2017-2020_C_T_0.8_16m.xlsx'
/


!------------------------------------------------------------------------------
!  Lake-specific parameters 
!------------------------------------------------------------------------------
&LAKE_PARAMS

depth_w_lk    = 17,        ! [m] <-- set South Center representative depth
fetch_lk      = 3018.0,      ! [m] <-- estimate (can refine later)
sediments_on  = .False.,
depth_bs_lk   = 5.0,         ! [m] thermally active sediment depth (ok default)
T_bs_lk       = 4.0,        ! [C] set = initial water temp for stability
latitude_lk   = 45.379         ! [deg] South Center ~45N (adjust if you know exact)
/

!------------------------------------------------------------------------------
! water transparency
!------------------------------------------------------------------------------
! South Center Lake
&TRANSPARENCY
nband_optic =     1        ! Number of wave-length bands
frac_optic =      1        ! Fractions of total radiation flux 
extincoef_optic = 1.3      ! Extinction coefficients      
/
